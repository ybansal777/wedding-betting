# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Settings → API → service_role.
# SERVER ONLY. This key bypasses Row Level Security, so it must never be given a
# NEXT_PUBLIC_ prefix — anything NEXT_PUBLIC_ is compiled into the browser
# bundle. (The old VITE_ADMIN_KEY had exactly this problem: it was compared in
# the browser and shipped in the public JS.)
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used to build guest share links. Leave blank locally.
NEXT_PUBLIC_SITE_URL=

# Sign-in methods: Google, phone, and email.
#
# Phone is a primary button now, so it needs to actually work before you run a
# real event: an SMS provider configured in Supabase (Authentication →
# Providers → Phone) and, for US numbers, A2P 10DLC registration — which takes
# weeks. Until then the button shows a clear "text messages aren't set up yet"
# message rather than a raw API error, and guests can still use Google or email.

# Stripe. Leave blank and the app still runs — every event stays on the free
# tier and the upgrade buttons report that payments aren't switched on, rather
# than failing in front of a host.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally,
# or the endpoint's signing secret in the Stripe dashboard. Without it the
# webhook refuses every delivery — it will not act on an unverified payload.
STRIPE_WEBHOOK_SECRET=

# Retention. The privacy notice promises event data is deleted 12 months after
# the wedding; /api/cron/purge is what keeps that promise, on the weekly
# schedule in vercel.json.
#
# That endpoint deletes customer data in bulk, so it refuses to run without a
# matching bearer token. Generate one with: openssl rand -base64 32
CRON_SECRET=
RETENTION_MONTHS=12

# Comma-separated emails allowed to see /dashboard/metrics. Anyone not listed
# gets a 404 — the page shouldn't confirm it exists.
ADMIN_EMAILS=
