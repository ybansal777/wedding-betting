# Copy this file to ".env" and fill in your values.
# All vars are exposed to the browser (Vite "VITE_" prefix) — this app holds no
# secrets, only a fake bragging-rights currency.

# From your Supabase project: Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shared code the couple types to open the admin console.
VITE_ADMIN_KEY=change-me-before-the-wedding

# The public URL guests visit (used for the admin QR code).
# Leave blank locally; set to your Vercel URL in production.
VITE_SITE_URL=
